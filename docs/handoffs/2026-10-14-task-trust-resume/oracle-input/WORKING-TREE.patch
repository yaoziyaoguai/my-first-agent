+    def _finish_unknown_effect_persistence_failure(
+        self,
+        action: Action,
+        current: LoadedSnapshot,
+        warnings: list[str],
+        error: Exception,
+    ) -> RunResult:
+        """UNKNOWN 的 recovery 落盘失败：如实失败，保留 durable 未知态。
+
+        不能报告任何尚未落盘的安全终态，也不能清空 run；action 本身仍按
